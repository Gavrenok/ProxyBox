[Unit]
Description=GeoBox web panel
After=network-online.target geobox-singbox.service
Wants=network-online.target

[Service]
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/geobox/geobox.py serve
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
