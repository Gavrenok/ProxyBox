[Unit]
Description=GeoBox proxy engine
After=network-online.target geobox-net.service
Wants=network-online.target
Requires=geobox-net.service

[Service]
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/sing-box run -c /etc/geobox/sing-box.json -D /var/lib/geobox
ExecStartPost=/opt/geobox/tun-route.sh
StateDirectory=geobox
Restart=always
RestartSec=3
LimitNOFILE=65535
UMask=0077

[Install]
WantedBy=multi-user.target
